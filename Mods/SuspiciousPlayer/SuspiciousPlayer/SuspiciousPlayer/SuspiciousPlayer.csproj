<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{1E23795A-8758-45DE-B962-B799C09CC923}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>SuspiciousPlayer</RootNamespace>
    <AssemblyName>SuspiciousPlayer</AssemblyName>
    <TargetFramework>net472</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType Condition="'$(Configuration)' == 'Debug'">full</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <!-- XNA 4.0 仅存在于 GAC（随 XNA Redistributable 安装），无 NuGet 分发，此处使用 GAC 确定性物理路径 -->
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath>
    </Reference>
    <!-- 原版 Terraria exe：路径由 monorepo 根 Directory.Build.props 的 TerrariaDir 注入；Private=false 避免复制游戏文件到输出目录 -->
    <Reference Include="Terraria">
      <HintPath>$(TerrariaDir)\Terraria.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ReLogic：原版 exe 仅引用未内嵌、游戏目录亦无此文件，按上游 wiki 约定改用 tModLoader 分发的 ReLogic.dll；
         路径由 Directory.Build.props 的 TModLoaderDir 注入 -->
    <Reference Include="ReLogic">
      <HintPath>$(TModLoaderDir)\Libraries\ReLogic\1.0.0\ReLogic.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\tPlainModLoader\tContentPatch\tContentPatch.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\tPlainModLoader\CommandHelp\CommandHelp.csproj" Private="false" />
  </ItemGroup>

  <!-- 构建后部署：产物及模组元数据发布到游戏目录下的 tPlainModLoader\Mods\SuspiciousPlayer 文件夹 -->
  <Target Name="DeployToGameDir" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(TerrariaDir)' != ''">
    <PropertyGroup>
      <ModSourceDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</ModSourceDir>
      <ModDeployDir>$(TerrariaDir)\tPlainModLoader\Mods\$(MSBuildProjectName)</ModDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(ModDeployDir)" />
    <Message Importance="High" Text="[DeployToGameDir] 部署模组 $(MSBuildProjectName) -> $(ModDeployDir)" />
    <Exec Condition="!Exists('$(ModDeployDir)\$(TargetFileName)')"
          Command="mklink /H &quot;$(ModDeployDir)\$(TargetFileName)&quot; &quot;$(TargetPath)&quot; 2>nul || mklink &quot;$(ModDeployDir)\$(TargetFileName)&quot; &quot;$(TargetPath)&quot; 2>nul || copy /y &quot;$(TargetPath)&quot; &quot;$(ModDeployDir)\$(TargetFileName)&quot;" />
    <Exec Condition="!Exists('$(ModDeployDir)\$(TargetName).pdb') and Exists('$(TargetDir)$(TargetName).pdb')"
          Command="mklink /H &quot;$(ModDeployDir)\$(TargetName).pdb&quot; &quot;$(TargetDir)$(TargetName).pdb&quot; 2>nul || mklink &quot;$(ModDeployDir)\$(TargetName).pdb&quot; &quot;$(TargetDir)$(TargetName).pdb&quot; 2>nul || copy /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(ModDeployDir)\$(TargetName).pdb&quot;" />
    <Exec Condition="!Exists('$(ModDeployDir)\info.json') and Exists('$(ModSourceDir)\info.json')"
          Command="mklink /H &quot;$(ModDeployDir)\info.json&quot; &quot;$(ModSourceDir)\info.json&quot; 2>nul || mklink &quot;$(ModDeployDir)\info.json&quot; &quot;$(ModSourceDir)\info.json&quot; 2>nul || copy /y &quot;$(ModSourceDir)\info.json&quot; &quot;$(ModDeployDir)\info.json&quot;" />
    <Exec Condition="!Exists('$(ModDeployDir)\loadConfig.json') and Exists('$(ModSourceDir)\loadConfig.json')"
          Command="mklink /H &quot;$(ModDeployDir)\loadConfig.json&quot; &quot;$(ModSourceDir)\loadConfig.json&quot; 2>nul || mklink &quot;$(ModDeployDir)\loadConfig.json&quot; &quot;$(ModSourceDir)\loadConfig.json&quot; 2>nul || copy /y &quot;$(ModSourceDir)\loadConfig.json&quot; &quot;$(ModDeployDir)\loadConfig.json&quot;" />
    <Exec Condition="!Exists('$(ModDeployDir)\ico.png') and Exists('$(ModSourceDir)\ico.png')"
          Command="mklink /H &quot;$(ModDeployDir)\ico.png&quot; &quot;$(ModSourceDir)\ico.png&quot; 2>nul || mklink &quot;$(ModDeployDir)\ico.png&quot; &quot;$(ModSourceDir)\ico.png&quot; 2>nul || copy /y &quot;$(ModSourceDir)\ico.png&quot; &quot;$(ModDeployDir)\ico.png&quot;" />
  </Target>

</Project>
