<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{A7BAD17D-ECAC-4F51-BA57-AD78B9BC02BF}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>tPlainModLoader</RootNamespace>
    <AssemblyName>tPlainModLoader</AssemblyName>
    <PackageId>tPlainModLoader</PackageId>
    <TargetFramework>net472</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DocumentationFile Condition="'$(Configuration)' == 'Debug'">bin\Debug\tPlainModLoader.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoMod.RuntimeDetour" Version="22.7.31.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="HarmonyX" Version="2.16.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- XNA 4.0 仅存在于 GAC（随 XNA Redistributable 安装），无 NuGet 分发，此处使用 GAC 确定性物理路径 -->
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath>
    </Reference>
    <!-- 原版 Terraria exe：路径由 monorepo 根 Directory.Build.props 的 TerrariaDir 注入；Private=false 避免复制游戏文件到输出目录 -->
    <Reference Include="Terraria">
      <HintPath>$(TerrariaDir)\Terraria.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ReLogic：原版 Terraria 专用的 .NET Framework 4.0 托管程序集（由 Directory.Build.props 的 ReLogicPath 注入，或 fallback 至 Libs\ReLogic.dll） -->
    <Reference Include="ReLogic">
      <HintPath Condition="'$(ReLogicPath)' != '' and Exists('$(ReLogicPath)')">$(ReLogicPath)</HintPath>
      <HintPath Condition="'$(ReLogicPath)' == '' or !Exists('$(ReLogicPath)')">$(MSBuildThisFileDirectory)..\..\Libs\ReLogic.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommandHelp\CommandHelp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core\Pinyin\PinyinResource.txt">
      <LogicalName>TPML.Core.Pinyin.PinyinResource.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Runtime\Resources\TitleLinkButtons.png">
      <LogicalName>tContentPatch.Resources.TitleLinkButtons.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Runtime\Resources\UI.ModIcon.png">
      <LogicalName>tContentPatch.Resources.UI.ModIcon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Runtime\Resources\UI.Workshop.HudModManager.png">
      <LogicalName>tContentPatch.Resources.UI.Workshop.HudModManager.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 构建后部署：产物复制发布到游戏目录下的 tPlainModLoader 文件夹 -->
  <Target Name="DeployToGameDir" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(TerrariaDir)' != ''">
    <PropertyGroup>
      <GameDeployDir>$(TerrariaDir)\tPlainModLoader</GameDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(GameDeployDir);$(GameDeployDir)\Mods" />
    <ItemGroup>
      <DeployFile Include="$(OutDir)tPlainModLoader.dll;$(OutDir)tPlainModLoader.xml" Condition="Exists('%(FullPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFile)" DestinationFolder="$(GameDeployDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>