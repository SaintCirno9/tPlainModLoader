<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{F00447E9-BA2A-41FB-AE78-933BFED21611}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>tPlainModLoaderInjector</RootNamespace>
    <AssemblyName>tPlainModLoaderInjector</AssemblyName>
    <TargetFramework>net472</TargetFramework>
    <!-- 注入器自身会被注入 32 位的原版游戏进程，必须 x86 -->
    <PlatformTarget>x86</PlatformTarget>
    <!-- 开启 4GB 虚拟内存感知 (LargeAddressAware) -->
    <LargeAddressAware>true</LargeAddressAware>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationIcon>ico2_256.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Debug'">full</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">pdbonly</DebugType>
    <!-- 保持上游行为：Debug 产物输出到主工程 bin，便于一并启动调试 -->
    <OutputPath Condition="'$(Configuration)' == 'Debug'">..\tPlainModLoader\bin\Debug\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TPML.Core\TPML.Core.csproj" />
    <ProjectReference Include="..\FastWin32-master\FastWin32\FastWin32.csproj" />
    <ProjectReference Include="..\tContentPatch\tContentPatch.csproj" />
  </ItemGroup>

  <!-- 内联任务：自动为 32 位 exe 注入 LargeAddressAware (0x0020) 标志，确保获得 4GB 虚拟内存感知 -->
  <UsingTask TaskName="SetLargeAddressAware" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          if (File.Exists(FilePath))
          {
              using (var stream = File.Open(FilePath, FileMode.Open, FileAccess.ReadWrite))
              using (var reader = new BinaryReader(stream))
              using (var writer = new BinaryWriter(stream))
              {
                  stream.Seek(0x3C, SeekOrigin.Begin);
                  int peOffset = reader.ReadInt32();
                  stream.Seek(peOffset + 0x16, SeekOrigin.Begin);
                  ushort chars = reader.ReadUInt16();
                  if ((chars & 0x0020) == 0)
                  {
                      chars |= 0x0020;
                      stream.Seek(peOffset + 0x16, SeekOrigin.Begin);
                      writer.Write(chars);
                      Log.LogMessage(MessageImportance.High, "[LargeAddressAware] 4GB 虚拟内存感知已注入: " + FilePath);
                  }
              }
          }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="EnableLargeAddressAware" AfterTargets="Build">
    <SetLargeAddressAware FilePath="$(TargetPath)" />
  </Target>

</Project>
